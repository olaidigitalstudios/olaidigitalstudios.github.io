---
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'OLAI Digital Studios | Independent Game Development Studio',
  description = 'OLAI Digital Studios is an independent game development studio based in Chennai, Tamil Nadu, India, crafting player-first mobile & arcade games.',
  ogImage = '/og-banner.png'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(ogImage, Astro.site);

const allGames = await getCollection('games');

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://olaidigitalstudios.github.io/#organization",
      "name": "Olai Digital Studios",
      "url": "https://olaidigitalstudios.github.io",
      "logo": new URL('/apple-touch-icon.png', Astro.site).toString(),
      "description": "Independent game development studio based in Chennai, Tamil Nadu, India, crafting player-first mobile & arcade games.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Chennai",
        "addressRegion": "Tamil Nadu",
        "addressCountry": "India"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "olaidigitalstudios@gmail.com",
        "contactType": "customer support"
      }
    },
    ...allGames.map((game) => {
      const playStore = game.data.storeLinks?.find((l) => l.platform === 'google-play' && l.url);
      const itch = game.data.storeLinks?.find((l) => l.platform === 'itch' && l.url);
      const primaryUrl = playStore?.url || itch?.url || `https://olaidigitalstudios.github.io/#${game.id}`;

      return {
        "@type": "VideoGame",
        "name": game.data.title,
        "description": game.data.tagline,
        "genre": game.data.genre,
        "operatingSystem": "Android",
        "applicationCategory": "GameApplication",
        "author": {
          "@id": "https://olaidigitalstudios.github.io/#organization"
        },
        "publisher": {
          "@id": "https://olaidigitalstudios.github.io/#organization"
        },
        "url": primaryUrl,
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD",
          "availability": game.data.status === 'Available Now' ? "https://schema.org/InStock" : "https://schema.org/PreOrder"
        }
      };
    })
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0C0D0E" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Olai Digital Studios" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body class="bg-void text-white min-h-screen">
    <slot />
  </body>
</html>

<style is:global>
  @import '../assets/styles/global.css';
</style>
