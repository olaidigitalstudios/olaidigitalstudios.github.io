---
// GameCard.astro — Clean artwork showcase card with centered title and pure store icon dock
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StoreIcon from './StoreIcon.astro';

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { title, genre, status, coverImage, coverAlt, storeLinks } = game.data;

const isLive = status === 'Available Now';
const singleGenre = genre.split('/')[0].trim();

const platformNames: Record<string, string> = {
  'google-play': 'Google Play',
  'microsoft-store': 'Microsoft Store',
  'itch': 'itch.io',
  'steam': 'Steam',
  'app-store': 'App Store',
  'web': 'Web'
};
---

<article class="relative flex flex-col h-full rounded-2xl bg-gradient-to-b from-surface-elevated/40 via-surface to-surface border-t border-t-white/20 border-x border-x-white/10 border-b border-b-white/10 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),0_8px_24px_-8px_rgba(0,0,0,0.6)] overflow-hidden">

  <!-- 1. Pure, 100% Clean Key Art Frame (Zero Overlays / No Badges on Art) -->
  <div class="relative aspect-video overflow-hidden bg-black/60 border-b border-white/[0.08]">
    <!-- Ambient blurred background fill for non-16:9 images -->
    <Image
      src={coverImage}
      alt=""
      width={320}
      height={180}
      format="webp"
      quality={30}
      class="pointer-events-none absolute inset-0 w-full h-full object-cover blur-xl scale-125 opacity-30 select-none"
      aria-hidden="true"
    />

    <!-- Main Key Art Image (Static, no scaling on hover) -->
    <Image
      src={coverImage}
      alt={coverAlt}
      width={640}
      height={360}
      format="webp"
      quality={85}
      loading="lazy"
      decoding="async"
      class="relative z-0 w-full h-full object-cover"
    />
  </div>

  <!-- 2. Clean Card Body -->
  <div class="flex flex-col flex-1 p-5 gap-4">

    <!-- Metadata Row: Genre + Status (Moved from image) -->
    <div class="flex items-center justify-between gap-2 text-[11px] font-sans">
      <span class="text-accent-gold font-semibold uppercase tracking-wider truncate max-w-[65%]">
        {singleGenre}
      </span>
      <span
        class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-medium tracking-normal shrink-0 ${
          isLive
            ? 'bg-emerald-950/60 text-emerald-400 border border-emerald-500/30'
            : 'bg-amber-950/60 text-amber-400 border border-amber-500/30'
        }`}
      >
        <span class={`w-1.5 h-1.5 rounded-full ${isLive ? 'bg-emerald-400' : 'bg-amber-400 animate-pulse'}`} aria-hidden="true"></span>
        {status}
      </span>
    </div>

    <!-- Centered Game Title (Static, no hover color shift) -->
    <h3 class="font-display font-bold text-xl sm:text-2xl text-white text-center leading-snug my-auto">
      {title}
    </h3>

    <!-- 3. Centered Store Icon Launcher Dock -->
    <div class="mt-auto pt-2 flex justify-center">
      {storeLinks && storeLinks.length > 0 && (
        isLive ? (
          <div class="flex items-center justify-center gap-2.5">
            {storeLinks.map((link) => {
              const hasUrl = Boolean(link.url) && link.url?.trim().toUpperCase() !== 'TBD';
              const platformName = platformNames[link.platform] ?? link.label;

              return hasUrl ? (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white/[0.04] text-stone-300 hover:text-accent-gold hover:border-accent-gold/40 hover:bg-accent-gold/10 hover:shadow-[0_0_12px_rgba(229,184,105,0.2)] hover:scale-105 border border-white/10 transition-[background-color,color,border-color,transform,box-shadow] duration-quick ease-smooth-out hover:-translate-y-0.5 active:translate-y-0 active:scale-95 active:bg-accent-gold/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-gold"
                  title={platformName}
                  aria-label={`Get ${title} on ${platformName} (opens in new tab)`}
                >
                  <StoreIcon platform={link.platform} class="w-5 h-5" />
                </a>
              ) : (
                <span
                  class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white/[0.03] text-gray-500 border border-white/5 cursor-not-allowed"
                  title={`${platformName} (Coming Soon)`}
                  aria-label={`${platformName} (Coming Soon)`}
                >
                  <StoreIcon platform={link.platform} class="w-5 h-5 opacity-60" />
                </span>
              );
            })}
          </div>
        ) : (
          <div class="flex flex-col items-center gap-1.5">
            <span class="text-[11px] font-sans font-medium uppercase tracking-wider text-stone-500">
              Planned on
            </span>
            <div class="flex items-center justify-center gap-2.5">
              {storeLinks.map((link) => {
                const platformName = platformNames[link.platform] ?? link.label;
                return (
                  <span
                    class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white/[0.02] text-gray-500 border border-white/5 cursor-not-allowed select-none"
                    title={`${platformName} — Planned`}
                    aria-label={`${platformName} (Planned)`}
                  >
                    <StoreIcon platform={link.platform} class="w-5 h-5 opacity-60" />
                  </span>
                );
              })}
            </div>
          </div>
        )
      )}
    </div>

  </div>
</article>
